{
  "name": "@joe-broadhead/opencode-history",
  "version": "0.0.1",
  "description": "Unofficial OpenCode plugin: search, read and recall your past OpenCode sessions",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "history"
  ],
  "homepage": "https://github.com/joe-broadhead/opencode-history#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-history/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-history.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "opencode": {
    "host": ">=2.2.3 <2.3.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ]
  },
  "jelly": {
    "title": "History",
    "summary": "Your past OpenCode sessions.",
    "icon": "assets/icon.svg",
    "tools": [
      {
        "name": "history.search",
        "permission": "history_search",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.brief",
        "permission": "history_brief",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.read",
        "permission": "history_read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.sessions",
        "permission": "history_sessions",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.files",
        "permission": "history_files",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.recall",
        "permission": "history_recall",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.sql",
        "permission": "history_sql",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.events_list",
        "permission": "history_events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "history.pin",
        "permission": "history_pin",
        "effect": "allow",
        "readOnly": false
      }
    ],
    "skills": [
      "history-recall"
    ],
    "rpc": [],
    "views": [],
    "signIns": [],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "default": "all",
          "choices": [
            { "value": "all", "label": "Allowed", "description": "Every tool runs without asking, reads and changes alike." },
            { "value": "ask-changes", "label": "Ask before changes", "description": "Reads run without asking. Each change asks you first." },
            { "value": "read-only", "label": "Read only", "description": "Reads run. Changes never run." }
          ],
          "description": "What History's tools may do without asking. Generates default rules for agents with a base allow rule."
        },
        {
          "key": "defaultScope",
          "label": "Default scope",
          "type": "string",
          "default": "project",
          "choices": [
            { "value": "project", "label": "This project", "description": "Sessions of the project you are in." },
            { "value": "directory", "label": "This folder", "description": "Sessions started in this folder or below it." },
            { "value": "all", "label": "Every project", "description": "Sessions of every project." }
          ],
          "description": "Where a search of past sessions looks when it names no scope."
        },
        {
          "key": "maskDefaults",
          "label": "Default masking",
          "type": "boolean",
          "default": true,
          "description": "Use the built-in masking patterns when indexing and returning session text."
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=2",
    "test:kit": "node --test scripts/release-kit.test.mjs",
    "build": "node scripts/build.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:tui": "npx -y bun@1.4.4 test test/tui",
    "test:pack": "npx -y bun@1.4.4 test test/pack",
    "bench": "vitest run -c vitest.bench.config.ts --silent=false",
    "lint": "node scripts/check-forbidden.mjs && node scripts/check-copies.mjs && node scripts/check-icons.mjs && node scripts/check-workflows.mjs",
    "check": "npm run typecheck && npm test && npm run test:kit && npm run build && npm run test:host && npm run test:tui && npm run lint && npm run test:pack"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/schema": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opencode/util": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "babel-preset-solid": "1.9.16",
    "effect": "4.0.6",
    "esbuild": "0.28.2",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
